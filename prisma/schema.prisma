// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  HEALTH_WORKER
  PARENT
}

enum HospitalStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum RegistrationType {
  DELIVERY
  TRANSFER
  WALK_IN
}

enum ImmunizationStatus {
  SCHEDULED
  COMPLETED
  MISSED
  OVERDUE
}

enum NotificationType {
  UPCOMING
  OVERDUE
  TRANSFER
  SYSTEM_ALERT
  PERFORMANCE_ALERT
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationFrequency {
  SINGLE
  DAILY
  ESCALATING
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AlertType {
  OVERDUE_THRESHOLD
  COMPLETION_DROP
  INACTIVE
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum AlertStatus {
  PENDING
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

enum ExportType {
  MOTHERS
  CHILDREN
  IMMUNIZATIONS
  FULL
}

enum ExportScope {
  HOSPITAL
  SYSTEM
}

enum ExportFormat {
  CSV
  EXCEL
  JSON
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum OptOutAction {
  OPT_IN
  OPT_OUT
}

// ==================== CORE MODELS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  role          UserRole
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Role-specific relations
  hospitalAdmin HospitalAdmin?
  healthWorker  HealthWorker?
  parent        Parent?

  // Audit relations
  createdById   String?
  createdBy     User?   @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers  User[]  @relation("CreatedBy")

  // Other relations
  mothersRegistered       Mother[]                @relation("RegisteredBy")
  childrenRegistered      Child[]                 @relation("ChildRegisteredBy")
  vaccinesCreated         HospitalVaccine[]       @relation("VaccineCreatedBy")
  vaccineVersionsChanged  HospitalVaccineVersion[] @relation("VaccineVersionChangedBy")
  schedulesLocked         ImmunizationSchedule[]  @relation("ScheduleLockedBy")
  immunizationsRecorded   ImmunizationRecord[]    @relation("ImmunizationRecordedBy")
  preferencesUpdated      MotherNotificationPreference[] @relation("PreferenceUpdatedBy")
  optOutLogsPerformed     NotificationOptOutLog[] @relation("OptOutPerformedBy")
  transfersRequested      TransferRequest[]       @relation("TransferRequestedBy")
  transfersApproved       TransferRequest[]       @relation("TransferApprovedBy")
  alertsAcknowledged      PerformanceAlert[]      @relation("AlertAcknowledgedBy")
  dataExports             DataExport[]
  alertRecipients         PerformanceAlertRecipient[]

  @@index([role])
  @@index([email])
}

model Hospital {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  code                String?        @unique
  address             String?
  city                String?
  state               String?
  country             String         @default("Uganda")
  phone               String?
  email               String?
  logo                String?
  status              HospitalStatus @default(PENDING)
  overdueThreshold    Int            @default(20)
  alertsEnabled       Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  admins              HospitalAdmin[]
  healthWorkers       HealthWorker[]
  mothers             Mother[]
  children            Child[]
  vaccines            HospitalVaccine[]
  immunizationRecords ImmunizationRecord[]
  notificationSettings HospitalNotificationSettings?
  performanceSnapshots HospitalPerformanceSnapshot[]
  performanceAlerts   PerformanceAlert[]
  transfersFrom       TransferRequest[] @relation("TransferFrom")
  transfersTo         TransferRequest[] @relation("TransferTo")
  transferHistory     TransferHistory[]
  dataExports         DataExport[]

  @@index([slug])
  @@index([status])
}

model HospitalAdmin {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hospitalId])
}

model HealthWorker {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId            String
  hospital              Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staffId               String?
  specialization        String?
  canRegisterMothers    Boolean  @default(true)
  canRegisterChildren   Boolean  @default(true)
  canRecordImmunizations Boolean @default(true)
  canViewAllPatients    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  immunizationsGiven ImmunizationRecord[]

  @@index([hospitalId])
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mothers   Mother[]
}

// ==================== HEALTH RECORDS ====================

model Mother {
  id                     String           @id @default(cuid())
  parentId               String?
  parent                 Parent?          @relation(fields: [parentId], references: [id])
  currentHospitalId      String
  currentHospital        Hospital         @relation(fields: [currentHospitalId], references: [id])
  registeredById         String
  registeredBy           User             @relation("RegisteredBy", fields: [registeredById], references: [id])
  registrationType       RegistrationType @default(DELIVERY)

  // Personal info
  firstName              String
  lastName               String
  dateOfBirth            DateTime?
  phone                  String
  alternatePhone         String?
  email                  String?
  address                String?
  city                   String?
  state                  String?

  // Medical info
  bloodGroup             String?
  genotype               String?
  allergies              String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  children               Child[]
  notificationPreference MotherNotificationPreference?

  @@index([currentHospitalId])
  @@index([phone])
  @@index([registeredById])
}

model Child {
  id                   String           @id @default(cuid())
  motherId             String
  mother               Mother           @relation(fields: [motherId], references: [id], onDelete: Cascade)
  currentHospitalId    String
  currentHospital      Hospital         @relation(fields: [currentHospitalId], references: [id])
  registeredById       String
  registeredBy         User             @relation("ChildRegisteredBy", fields: [registeredById], references: [id])
  registeredWithMother Boolean          @default(true)

  // Personal info
  firstName            String
  lastName             String
  dateOfBirth          DateTime
  gender               Gender
  birthWeight          Float?

  // Medical info
  bloodGroup           String?
  genotype             String?
  allergies            String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  immunizationSchedules ImmunizationSchedule[]
  immunizationRecords   ImmunizationRecord[]

  @@index([motherId])
  @@index([currentHospitalId])
  @@index([dateOfBirth])
}

// ==================== VACCINE MANAGEMENT ====================

model HospitalVaccine {
  id                 String   @id @default(cuid())
  hospitalId         String
  hospital           Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name               String
  shortName          String
  description        String?
  manufacturer       String?
  dosesRequired      Int      @default(1)
  minAgeWeeks        Int
  maxAgeWeeks        Int?
  intervalWeeks      Int?
  reminderDaysBefore Int      @default(3)
  isActive           Boolean  @default(true)
  currentVersionId   String?
  createdById        String
  createdBy          User     @relation("VaccineCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  versions            HospitalVaccineVersion[]
  immunizationSchedules ImmunizationSchedule[]
  immunizationRecords ImmunizationRecord[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@index([isActive])
}

model HospitalVaccineVersion {
  id            String   @id @default(cuid())
  vaccineId     String
  vaccine       HospitalVaccine @relation(fields: [vaccineId], references: [id], onDelete: Cascade)
  versionNumber Int
  name          String
  minAgeWeeks   Int
  maxAgeWeeks   Int?
  intervalWeeks Int?
  dosesRequired Int
  changedById   String
  changedBy     User     @relation("VaccineVersionChangedBy", fields: [changedById], references: [id])
  changeReason  String?
  changedAt     DateTime @default(now())

  // Relations
  immunizationSchedules ImmunizationSchedule[]

  @@unique([vaccineId, versionNumber])
  @@index([vaccineId])
}

// ==================== IMMUNIZATION ====================

model ImmunizationSchedule {
  id                      String             @id @default(cuid())
  childId                 String
  child                   Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  vaccineId               String
  vaccine                 HospitalVaccine    @relation(fields: [vaccineId], references: [id])
  vaccineVersionId        String?
  vaccineVersion          HospitalVaccineVersion? @relation(fields: [vaccineVersionId], references: [id])
  doseNumber              Int                @default(1)
  scheduledDate           DateTime
  status                  ImmunizationStatus @default(SCHEDULED)
  autoGenerated           Boolean            @default(true)
  isLocked                Boolean            @default(false)
  lockedAt                DateTime?
  lockedById              String?
  lockedBy                User?              @relation("ScheduleLockedBy", fields: [lockedById], references: [id])
  reminderSentAt          DateTime?
  overdueNotificationCount Int               @default(0)
  lastNotifiedAt          DateTime?
  nextNotificationAt      DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations
  immunizationRecord ImmunizationRecord?
  notifications      Notification[]

  @@unique([childId, vaccineId, doseNumber])
  @@index([scheduledDate])
  @@index([status])
  @@index([childId])
}

model ImmunizationRecord {
  id             String   @id @default(cuid())
  scheduleId     String   @unique
  schedule       ImmunizationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  vaccineId      String
  vaccine        HospitalVaccine @relation(fields: [vaccineId], references: [id])
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id])
  healthWorkerId String
  healthWorker   HealthWorker @relation(fields: [healthWorkerId], references: [id])
  recordedById   String
  recordedBy     User     @relation("ImmunizationRecordedBy", fields: [recordedById], references: [id])

  doseNumber     Int
  administeredAt DateTime @default(now())
  batchNumber    String?
  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([childId])
  @@index([hospitalId])
  @@index([administeredAt])
}

// ==================== NOTIFICATIONS ====================

model MotherNotificationPreference {
  id           String   @id @default(cuid())
  motherId     String   @unique
  mother       Mother   @relation(fields: [motherId], references: [id], onDelete: Cascade)
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  optOutAt     DateTime?
  optOutReason String?
  updatedById  String?
  updatedBy    User?    @relation("PreferenceUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  optOutLogs   NotificationOptOutLog[]
}

model NotificationOptOutLog {
  id            String       @id @default(cuid())
  preferenceId  String
  preference    MotherNotificationPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  action        OptOutAction
  reason        String?
  performedById String
  performedBy   User         @relation("OptOutPerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime     @default(now())

  @@index([preferenceId])
  @@index([performedAt])
}

model HospitalNotificationSettings {
  id                  String              @id @default(cuid())
  hospitalId          String              @unique
  hospital            Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  frequency           NotificationFrequency @default(ESCALATING)
  escalationDays      Json                @default("[1, 3, 7, 14]")
  emailEnabled        Boolean             @default(true)
  smsEnabled          Boolean             @default(true)
  pushEnabled         Boolean             @default(true)
  reminderDaysBefore  Int                 @default(3)
  quietHoursStart     Int?                // Hour of day (0-23)
  quietHoursEnd       Int?                // Hour of day (0-23)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Notification {
  id           String             @id @default(cuid())
  type         NotificationType
  channel      NotificationChannel
  status       NotificationStatus @default(PENDING)
  recipientId  String
  scheduleId   String?
  schedule     ImmunizationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  subject      String?
  body         String
  scheduledFor DateTime?
  sentAt       DateTime?
  failedReason String?
  attempt      Int                @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([recipientId])
  @@index([status])
  @@index([scheduledFor])
  @@index([type])
}

// ==================== TRANSFERS ====================

model TransferRequest {
  id              String         @id @default(cuid())
  fromHospitalId  String
  fromHospital    Hospital       @relation("TransferFrom", fields: [fromHospitalId], references: [id])
  toHospitalId    String
  toHospital      Hospital       @relation("TransferTo", fields: [toHospitalId], references: [id])
  motherId        String
  status          TransferStatus @default(PENDING)
  requestedById   String
  requestedBy     User           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([fromHospitalId])
  @@index([toHospitalId])
  @@index([status])
}

model TransferHistory {
  id              String   @id @default(cuid())
  motherId        String
  childIds        Json     // Array of child IDs transferred
  fromHospitalId  String
  toHospitalId    String
  hospital        Hospital @relation(fields: [toHospitalId], references: [id])
  transferredAt   DateTime @default(now())
  snapshotData    Json     // Full snapshot of records at transfer time

  @@index([motherId])
  @@index([transferredAt])
}

// ==================== PERFORMANCE & ALERTS ====================

model HospitalPerformanceSnapshot {
  id             String   @id @default(cuid())
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  totalScheduled Int
  totalCompleted Int
  totalOverdue   Int
  overdueRate    Float
  completionRate Float
  createdAt      DateTime @default(now())

  @@unique([hospitalId, date])
  @@index([hospitalId])
  @@index([date])
}

model PerformanceAlert {
  id                String        @id @default(cuid())
  hospitalId        String
  hospital          Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  type              AlertType
  severity          AlertSeverity @default(WARNING)
  threshold         Float
  actualValue       Float
  message           String
  status            AlertStatus   @default(PENDING)
  escalationLevel   Int           @default(1)
  lastEscalatedAt   DateTime?
  nextEscalationAt  DateTime?
  triggeredAt       DateTime      @default(now())
  acknowledgedById  String?
  acknowledgedBy    User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  resolvedNote      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  recipients        PerformanceAlertRecipient[]
  escalationLogs    PerformanceAlertEscalationLog[]

  @@index([hospitalId])
  @@index([status])
  @@index([triggeredAt])
}

model PerformanceAlertRecipient {
  id         String              @id @default(cuid())
  alertId    String
  alert      PerformanceAlert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  role       UserRole
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  notifiedAt DateTime?

  @@index([alertId])
  @@index([userId])
}

model PerformanceAlertEscalationLog {
  id              String           @id @default(cuid())
  alertId         String
  alert           PerformanceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  escalationLevel Int
  recipientCount  Int
  note            String?
  escalatedAt     DateTime         @default(now())

  @@index([alertId])
}

model SystemAlertSettings {
  id                      String   @id @default(cuid())
  overdueThresholdDefault Int      @default(20)
  completionDropThreshold Int      @default(10)
  inactivityDays          Int      @default(30)
  escalationDelayDays     Int      @default(3)
  maxEscalationLevel      Int      @default(3)
  criticalThreshold       Int      @default(40)
  emailAlertsEnabled      Boolean  @default(true)
  pushAlertsEnabled       Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ==================== DATA EXPORT ====================

model DataExport {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  exportType  ExportType
  scope       ExportScope
  hospitalId  String?
  hospital    Hospital?    @relation(fields: [hospitalId], references: [id])
  filters     Json?
  format      ExportFormat
  recordCount Int?
  fileUrl     String?
  status      ExportStatus @default(PENDING)
  requestedAt DateTime     @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  // Relations
  auditLogs   DataExportAuditLog[]

  @@index([userId])
  @@index([status])
}

model DataExportAuditLog {
  id          String     @id @default(cuid())
  exportId    String
  export      DataExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  userId      String
  action      String     // REQUESTED, DOWNLOADED, EXPIRED, DELETED
  ipAddress   String?
  userAgent   String?
  performedAt DateTime   @default(now())

  @@index([exportId])
  @@index([performedAt])
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entity      String
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

